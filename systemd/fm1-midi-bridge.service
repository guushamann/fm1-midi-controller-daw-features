[Unit]
Description=FM-1 MIDI Bridge
After=sound.target network.target

[Service]
Type=simple
User=guus
Group=guus
WorkingDirectory=/home/guus/fm1-midi-bridge
Environment="HOME=/home/guus"
Environment="USER=guus"
Environment="PATH=/home/guus/fm1-midi-bridge/.venv/bin:/home/guus/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/guus/fm1-midi-bridge/.venv/bin/python main.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
